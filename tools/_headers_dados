# Cabeçalhos do projeto de dados do DAMNUM no Cloudflare Pages (copiar como _headers
# para a raiz da pasta publicada). Os blocos são imutáveis: nova versão, nova pasta.
/v1/blocos/*
  Access-Control-Allow-Origin: https://damnum.consciencia.eco.br
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
  X-Content-Type-Options: nosniff
/v1/*.json
  Access-Control-Allow-Origin: https://damnum.consciencia.eco.br
  Cache-Control: public, max-age=300
