# Cabeçalhos do projeto de dados do DAMNUM no Cloudflare Pages (copiar como _headers
# para a raiz da pasta publicada). Os blocos são imutáveis: nova versão, nova pasta.
/v1/blocos/*
  Access-Control-Allow-Origin: https://consciencia.eco.br
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
  X-Content-Type-Options: nosniff
/v1/*.json
  Access-Control-Allow-Origin: https://consciencia.eco.br
  Cache-Control: public, max-age=300
# PRODES e DETER (sugestão da data do dano). Cada atualização vai para uma pasta nova
# (prodes/AAAA-MM), e prodes/atual.json aponta a que vale.
/prodes/atual.json
  Access-Control-Allow-Origin: https://consciencia.eco.br
  Cache-Control: public, max-age=300
/prodes/:versao/indice.json
  Access-Control-Allow-Origin: https://consciencia.eco.br
  Cache-Control: public, max-age=300
/prodes/:versao/versao.json
  Access-Control-Allow-Origin: https://consciencia.eco.br
  Cache-Control: public, max-age=300
/prodes/:versao/blocos/*
  Access-Control-Allow-Origin: https://consciencia.eco.br
  Cache-Control: public, max-age=31536000, immutable
  Content-Type: application/octet-stream
  X-Content-Type-Options: nosniff
